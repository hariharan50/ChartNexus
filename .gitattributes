# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must stay LF
*.sh text eol=lf

# Binary assets — never diff or normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.whl binary

# SVG is text but should not be diffed inline
*.svg text eol=lf -diff

# Lockfiles: text, but collapsed in diffs and marked generated on GitHub
uv.lock text eol=lf linguist-generated=true -diff
pnpm-lock.yaml text eol=lf linguist-generated=true -diff

# Generated API client is not authored code
frontend/src/lib/shared/api/generated/** linguist-generated=true

# Keep infra/docs out of GitHub's language statistics
docs/** linguist-documentation=true
deploy/** linguist-vendored=true
infrastructure/** linguist-vendored=true
observability/** linguist-vendored=true
