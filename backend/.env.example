# Backend configuration. Copy to backend/.env and adjust.
#   cp backend/.env.example backend/.env
#
# Every variable maps to a field in chartnexus.bootstrap.settings.
# Unset variables fall back to the defaults declared there, which are tuned for
# local development. Deployed environments fail to start if the placeholder
# secrets below are left in place.

# --- process ---------------------------------------------------------------
CN_ENVIRONMENT=local           # local | test | staging | production
CN_DEBUG=true
CN_API_ROOT_PATH=
CN_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- postgres --------------------------------------------------------------
# Port 5433/6380, not 5432/6379: the compose stack shifts the host ports so a
# Postgres or Redis already installed on this machine keeps working.
CN_DB_URL=postgresql+asyncpg://chartnexus:chartnexus@localhost:5433/chartnexus
CN_DB_POOL_SIZE=10
CN_DB_MAX_OVERFLOW=10
CN_DB_STATEMENT_TIMEOUT_MS=15000
CN_DB_ECHO=false

# --- redis -----------------------------------------------------------------
CN_REDIS_URL=redis://localhost:6381/0
CN_REDIS_MAX_CONNECTIONS=50
CN_REDIS_KEY_PREFIX=cn

# --- security --------------------------------------------------------------
# Generate real values with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CN_SECURITY_SECRET_KEY=dev-only-insecure-secret-key-change-me
# AES-256-GCM key material for stored broker credentials. At least 32 bytes.
CN_SECURITY_ENCRYPTION_KEY=dev-only-insecure-encryption-key-change
# Comma-separated retired keys, kept only long enough to re-encrypt old rows.
CN_SECURITY_PREVIOUS_ENCRYPTION_KEYS=
CN_SECURITY_SESSION_TTL_SECONDS=43200
CN_SECURITY_COOKIE_SECURE=false      # false only because local dev is plain HTTP
CN_SECURITY_COOKIE_SAMESITE=lax

# --- auth (JWT + sessions) --------------------------------------------------
# HS256 needs at least 32 bytes; the process refuses to start with less.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left blank locally it falls back to CN_SECURITY_SECRET_KEY, but a deployed
# environment must set it explicitly.
CN_AUTH_JWT_ALGORITHM=HS256
CN_AUTH_JWT_SIGNING_KEY=
CN_AUTH_JWT_KEY_ID=cn-1
CN_AUTH_ISSUER=chartnexus
CN_AUTH_AUDIENCE=chartnexus-api
# Access tokens are not revocable, so keep the window short; revocation is
# enforced at refresh time against the database.
CN_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
CN_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Tolerance for two tabs refreshing at once. 0 makes any replay a revocation.
CN_AUTH_REFRESH_REUSE_GRACE_SECONDS=10
CN_AUTH_MAX_ACTIVE_SESSIONS_PER_USER=10
CN_AUTH_REGISTRATION_ENABLED=true
CN_AUTH_REQUIRE_EMAIL_VERIFICATION=false
CN_AUTH_LOGIN_MAX_ATTEMPTS=8
CN_AUTH_LOGIN_LOCKOUT_SECONDS=900

# --- google sso -------------------------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and register the redirect
# URI below as an "Authorized redirect URI". Leave blank to disable Google
# sign-in; the rest of the API works without it.
CN_GOOGLE_CLIENT_ID=
CN_GOOGLE_CLIENT_SECRET=
CN_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Restrict to Workspace domains, e.g. ["chartnexus.app"]. Empty allows any
# Google account, including personal gmail.com addresses.
CN_GOOGLE_ALLOWED_HOSTED_DOMAINS=[]

# --- broker ----------------------------------------------------------------
# 'mock' serves generated quotes and option chains — no Fyers account needed.
CN_BROKER_PROVIDER=mock
CN_BROKER_FYERS_APP_ID=
CN_BROKER_FYERS_SECRET_ID=
CN_BROKER_FYERS_REDIRECT_URI=http://localhost:5173/settings/broker/callback
CN_BROKER_QUOTA_REQUESTS_PER_SECOND=8

# --- llm / ai console ------------------------------------------------------
# LLM keys are PER-USER. Each user adds their own provider + API key + model at
# Settings -> AI in the app; the key is stored encrypted at rest and the agents
# (Hella, STRYX) read it per request. There is NO shared server key: with no key
# saved, that user's AI Console tab shows an "offline" notice.
#
# Install the model SDK so a saved Anthropic key can be used:  uv sync --extra llm
# (Claude only at launch; OpenAI/OpenRouter are reserved.)
#
# The provider/key/model vars below are LEGACY and no longer serve end users —
# leave them unset. Only the operational knobs are still read from env; all are
# optional and default sensibly:
#   CN_LLM_MAX_OUTPUT_TOKENS=4096
#   CN_LLM_REQUEST_TIMEOUT_SECONDS=30
#   CN_LLM_AGENT_DISCLAIMER=true        # append the educational disclaimer

# --- observability ---------------------------------------------------------
CN_OTEL_SERVICE_NAME=chartnexus
CN_OTEL_LOG_LEVEL=INFO
CN_OTEL_LOG_FORMAT=console          # 'json' in deployed environments
CN_OTEL_TRACES_ENABLED=false
CN_OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# --- market ----------------------------------------------------------------
CN_MARKET_TIMEZONE=Asia/Kolkata
CN_MARKET_SESSION_OPEN=09:15
# 15:40 is the F&O close (from 3 Aug 2026); the cash close stays 15:30.
CN_MARKET_SESSION_CLOSE=15:40
CN_MARKET_SNAPSHOT_INTERVAL_SECONDS=180

# --- option-chain archive (what the Open Interest timeline scrubs over) ------
# Write snapshots even when the chain came from the mock provider. On by default
# in compose.dev.yml; without it a machine with no broker connection never
# accumulates history. Leave false anywhere the data might be believed.
CN_MARKET_INGEST_ALLOW_MOCK=false
CN_MARKET_SNAPSHOT_RETENTION_DAYS=30
# Strikes either side of ATM kept per frame. The widest UI filter is +-20.
CN_MARKET_SNAPSHOT_MAX_SERIES_STRIKES=25

# ---------------------------------------------------------------------------
# Trade Buddy — morning levels, watched live, alerted once
# ---------------------------------------------------------------------------
# Mark S1-S3 and R1-R3 per index before the open; the watcher compares live
# price against them and alerts on approaches, touches, confirmed breaks,
# rejected wicks, reclaims and opening gaps.
#
# Credentials come from the broker you connect in Settings -> Broker, not
# from here. The watcher starts regardless and idles until one appears, so
# connecting mid-session brings it up without a restart.
CN_TRADE_BUDDY_ENABLED=true
# LOCAL-only in-process worker, like the other loops. Deployed environments run
# the standalone `chartnexus-trade-buddy` process instead.
CN_TRADE_BUDDY_IN_PROCESS=true

# Canonical names, never broker strings. BANKNIFTY is quoted as NIFTYBANK and
# the mapping is a catalog lookup, not a pattern — see symbol_mapper.py. Only
# the indices with levels marked are actually watched.
CN_TRADE_BUDDY_SYMBOLS=["NIFTY","BANKNIFTY","SENSEX"]

# --- the feed ---------------------------------------------------------------
# Requires the optional extra:  uv sync --extra fyers-stream
#
# OVERRIDE ONLY. Leave both blank in normal use: the watcher reads the broker
# connected through the app, re-resolved every session because a Fyers token
# expires daily. Set these two only to run the watcher against a different
# account from the connected one, or in a deployment with no UI. When both are
# set they are used **only** if no broker is connected.
CN_TRADE_BUDDY_FYERS_APP_ID=
CN_TRADE_BUDDY_FYERS_ACCESS_TOKEN=
# Litemode sends only LTP, which is all a level watcher needs.
CN_TRADE_BUDDY_LITEMODE=true

# --- the bands --------------------------------------------------------------
# ATR multiples, not points. A point value cannot serve three indices: twelve
# points is 6% of NIFTY's daily range and 1.5% of SENSEX's, so the same number
# is a sane buffer on one and inside the tick noise on the other. These
# defaults reproduce the historical 6/25/12 points on NIFTY (ATR(14) ~= 200).
CN_TRADE_BUDDY_TOUCH_ATR_MULTIPLE=0.03
CN_TRADE_BUDDY_APPROACH_ATR_MULTIPLE=0.125
CN_TRADE_BUDDY_BREAK_ATR_MULTIPLE=0.06
CN_TRADE_BUDDY_ATR_PERIOD=14

# Used only when ATR is unavailable (thin history, provider down). A degraded
# mode: these are NIFTY-sized, so on BANKNIFTY and SENSEX they are too tight.
# The page says so rather than applying them silently.
CN_TRADE_BUDDY_TOUCH_BAND_POINTS=6.0
CN_TRADE_BUDDY_APPROACH_BAND_POINTS=25.0
CN_TRADE_BUDDY_BREAK_BUFFER_POINTS=12.0

# How long price must hold beyond the buffer to confirm a break. A duration, so
# it does not scale with the instrument. The timer resets on re-entry, so
# repeated pokes never accumulate into a hold.
CN_TRADE_BUDDY_CONFIRM_HOLD_SECONDS=20.0

# --- throttling -------------------------------------------------------------
# Gate observations only. Confirmed breaks, reclaims and gaps bypass both: a
# cap that can swallow a real break has made the alerting worse than none.
# Both are overridable per index from the page.
CN_TRADE_BUDDY_COOLDOWN_MINUTES=20.0
CN_TRADE_BUDDY_DAILY_ALERT_CAP=3

# --- the watch window -------------------------------------------------------
# Narrower than CN_MARKET_SESSION_CLOSE (15:40, derivatives-facing): a level
# alert at 15:38 is not actionable.
CN_TRADE_BUDDY_WATCH_OPEN=09:15
CN_TRADE_BUDDY_WATCH_CLOSE=15:20
# NSE holidays as comma-separated ISO dates. Empty means weekday-only — but
# then the feed watchdog pages you about a dead feed on each holiday, because
# no tick is indistinguishable from a dead socket. Worth keeping current.
CN_TRADE_BUDDY_HOLIDAYS=
# Seconds of silence during market hours before the feed is called suspect.
CN_TRADE_BUDDY_STALE_AFTER_SECONDS=90.0

# --- channels ---------------------------------------------------------------
# Telegram gets everything, including rejected wicks. WhatsApp gets only
# confirmed facts, because CallMeBot throttles and sends plain text only.
# Leaving a channel's credentials blank disables it rather than failing
# startup: Telegram-only is a perfectly good configuration.
CN_TRADE_BUDDY_TELEGRAM_BOT_TOKEN=
CN_TRADE_BUDDY_TELEGRAM_CHAT_ID=
# Optional deep link for the inline "Open chart" button on Telegram alerts.
CN_TRADE_BUDDY_CHART_URL=
CN_TRADE_BUDDY_WHATSAPP_PHONE=
CN_TRADE_BUDDY_WHATSAPP_API_KEY=
# Set below CallMeBot's real ~25/4h ceiling. Exceeding it does not reject a
# message, it makes delivery unreliable — and a channel you cannot trust is
# worse than one you know is off.
CN_TRADE_BUDDY_WHATSAPP_LIMIT_PER_WINDOW=20
CN_TRADE_BUDDY_WHATSAPP_WINDOW_HOURS=4

CN_TRADE_BUDDY_SEND_ATTEMPTS=3
CN_TRADE_BUDDY_SEND_BACKOFF_SECONDS=0.5
CN_TRADE_BUDDY_REQUEST_TIMEOUT_SECONDS=10.0

# Marked levels and live watcher state, one JSON file per instrument. A file
# rather than a table: six numbers per index per day, one writer, worthless by
# tomorrow. Gitignored. Persisted so a restart mid-session resumes rather than
# re-firing alerts for ground already covered.
CN_TRADE_BUDDY_STATE_DIRECTORY=var/trade_buddy
