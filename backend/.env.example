# Backend configuration. Copy to backend/.env and adjust.
#   cp backend/.env.example backend/.env
#
# Every variable maps to a field in marketcompass.bootstrap.settings.
# Unset variables fall back to the defaults declared there, which are tuned for
# local development. Deployed environments fail to start if the placeholder
# secrets below are left in place.

# --- process ---------------------------------------------------------------
MC_ENVIRONMENT=local           # local | test | staging | production
MC_DEBUG=true
MC_API_ROOT_PATH=
MC_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- postgres --------------------------------------------------------------
# Port 5433/6380, not 5432/6379: the compose stack shifts the host ports so a
# Postgres or Redis already installed on this machine keeps working.
MC_DB_URL=postgresql+asyncpg://marketcompass:marketcompass@localhost:5433/marketcompass
MC_DB_POOL_SIZE=10
MC_DB_MAX_OVERFLOW=10
MC_DB_STATEMENT_TIMEOUT_MS=15000
MC_DB_ECHO=false

# --- redis -----------------------------------------------------------------
MC_REDIS_URL=redis://localhost:6381/0
MC_REDIS_MAX_CONNECTIONS=50
MC_REDIS_KEY_PREFIX=mc

# --- security --------------------------------------------------------------
# Generate real values with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
MC_SECURITY_SECRET_KEY=dev-only-insecure-secret-key-change-me
# AES-256-GCM key material for stored broker credentials. At least 32 bytes.
MC_SECURITY_ENCRYPTION_KEY=dev-only-insecure-encryption-key-change
# Comma-separated retired keys, kept only long enough to re-encrypt old rows.
MC_SECURITY_PREVIOUS_ENCRYPTION_KEYS=
MC_SECURITY_SESSION_TTL_SECONDS=43200
MC_SECURITY_COOKIE_SECURE=false      # false only because local dev is plain HTTP
MC_SECURITY_COOKIE_SAMESITE=lax

# --- auth (JWT + sessions) --------------------------------------------------
# HS256 needs at least 32 bytes; the process refuses to start with less.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left blank locally it falls back to MC_SECURITY_SECRET_KEY, but a deployed
# environment must set it explicitly.
MC_AUTH_JWT_ALGORITHM=HS256
MC_AUTH_JWT_SIGNING_KEY=
MC_AUTH_JWT_KEY_ID=mc-1
MC_AUTH_ISSUER=marketcompass
MC_AUTH_AUDIENCE=marketcompass-api
# Access tokens are not revocable, so keep the window short; revocation is
# enforced at refresh time against the database.
MC_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
MC_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Tolerance for two tabs refreshing at once. 0 makes any replay a revocation.
MC_AUTH_REFRESH_REUSE_GRACE_SECONDS=10
MC_AUTH_MAX_ACTIVE_SESSIONS_PER_USER=10
MC_AUTH_REGISTRATION_ENABLED=true
MC_AUTH_REQUIRE_EMAIL_VERIFICATION=false
MC_AUTH_LOGIN_MAX_ATTEMPTS=8
MC_AUTH_LOGIN_LOCKOUT_SECONDS=900

# --- google sso -------------------------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and register the redirect
# URI below as an "Authorized redirect URI". Leave blank to disable Google
# sign-in; the rest of the API works without it.
MC_GOOGLE_CLIENT_ID=
MC_GOOGLE_CLIENT_SECRET=
MC_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Restrict to Workspace domains, e.g. ["marketcompass.app"]. Empty allows any
# Google account, including personal gmail.com addresses.
MC_GOOGLE_ALLOWED_HOSTED_DOMAINS=[]

# --- broker ----------------------------------------------------------------
# 'mock' serves generated quotes and option chains — no Fyers account needed.
MC_BROKER_PROVIDER=mock
MC_BROKER_FYERS_APP_ID=
MC_BROKER_FYERS_SECRET_ID=
MC_BROKER_FYERS_REDIRECT_URI=http://localhost:5173/settings/broker/callback
MC_BROKER_QUOTA_REQUESTS_PER_SECOND=8

# --- llm -------------------------------------------------------------------
# 'rule_based' needs no API key and keeps the copilot deterministic in tests.
MC_LLM_PROVIDER=rule_based
MC_LLM_ANTHROPIC_API_KEY=
MC_LLM_OPENAI_API_KEY=
MC_LLM_MODEL=claude-sonnet-5

# --- observability ---------------------------------------------------------
MC_OTEL_SERVICE_NAME=marketcompass
MC_OTEL_LOG_LEVEL=INFO
MC_OTEL_LOG_FORMAT=console          # 'json' in deployed environments
MC_OTEL_TRACES_ENABLED=false
MC_OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# --- market ----------------------------------------------------------------
MC_MARKET_TIMEZONE=Asia/Kolkata
MC_MARKET_SESSION_OPEN=09:15
# 15:40 is the F&O close (from 3 Aug 2026); the cash close stays 15:30.
MC_MARKET_SESSION_CLOSE=15:40
MC_MARKET_SNAPSHOT_INTERVAL_SECONDS=180

# --- option-chain archive (what the Open Interest timeline scrubs over) ------
# Write snapshots even when the chain came from the mock provider. On by default
# in compose.dev.yml; without it a machine with no broker connection never
# accumulates history. Leave false anywhere the data might be believed.
MC_MARKET_INGEST_ALLOW_MOCK=false
MC_MARKET_SNAPSHOT_RETENTION_DAYS=30
# Strikes either side of ATM kept per frame. The widest UI filter is +-20.
MC_MARKET_SNAPSHOT_MAX_SERIES_STRIKES=25
