# Backend configuration. Copy to backend/.env and adjust.
#   cp backend/.env.example backend/.env
#
# Every variable maps to a field in chartnexus.bootstrap.settings.
# Unset variables fall back to the defaults declared there, which are tuned for
# local development. Deployed environments fail to start if the placeholder
# secrets below are left in place.

# --- process ---------------------------------------------------------------
CN_ENVIRONMENT=local           # local | test | staging | production
CN_DEBUG=true
CN_API_ROOT_PATH=
CN_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- postgres --------------------------------------------------------------
# Port 5433/6380, not 5432/6379: the compose stack shifts the host ports so a
# Postgres or Redis already installed on this machine keeps working.
CN_DB_URL=postgresql+asyncpg://chartnexus:chartnexus@localhost:5433/chartnexus
CN_DB_POOL_SIZE=10
CN_DB_MAX_OVERFLOW=10
CN_DB_STATEMENT_TIMEOUT_MS=15000
CN_DB_ECHO=false

# --- redis -----------------------------------------------------------------
CN_REDIS_URL=redis://localhost:6381/0
CN_REDIS_MAX_CONNECTIONS=50
CN_REDIS_KEY_PREFIX=cn

# --- security --------------------------------------------------------------
# Generate real values with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CN_SECURITY_SECRET_KEY=dev-only-insecure-secret-key-change-me
# AES-256-GCM key material for stored broker credentials. At least 32 bytes.
CN_SECURITY_ENCRYPTION_KEY=dev-only-insecure-encryption-key-change
# Comma-separated retired keys, kept only long enough to re-encrypt old rows.
CN_SECURITY_PREVIOUS_ENCRYPTION_KEYS=
CN_SECURITY_SESSION_TTL_SECONDS=43200
CN_SECURITY_COOKIE_SECURE=false      # false only because local dev is plain HTTP
CN_SECURITY_COOKIE_SAMESITE=lax

# --- auth (JWT + sessions) --------------------------------------------------
# HS256 needs at least 32 bytes; the process refuses to start with less.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left blank locally it falls back to CN_SECURITY_SECRET_KEY, but a deployed
# environment must set it explicitly.
CN_AUTH_JWT_ALGORITHM=HS256
CN_AUTH_JWT_SIGNING_KEY=
CN_AUTH_JWT_KEY_ID=cn-1
CN_AUTH_ISSUER=chartnexus
CN_AUTH_AUDIENCE=chartnexus-api
# Access tokens are not revocable, so keep the window short; revocation is
# enforced at refresh time against the database.
CN_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
CN_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Tolerance for two tabs refreshing at once. 0 makes any replay a revocation.
CN_AUTH_REFRESH_REUSE_GRACE_SECONDS=10
CN_AUTH_MAX_ACTIVE_SESSIONS_PER_USER=10
CN_AUTH_REGISTRATION_ENABLED=true
CN_AUTH_REQUIRE_EMAIL_VERIFICATION=false
CN_AUTH_LOGIN_MAX_ATTEMPTS=8
CN_AUTH_LOGIN_LOCKOUT_SECONDS=900

# --- google sso -------------------------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and register the redirect
# URI below as an "Authorized redirect URI". Leave blank to disable Google
# sign-in; the rest of the API works without it.
CN_GOOGLE_CLIENT_ID=
CN_GOOGLE_CLIENT_SECRET=
CN_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Restrict to Workspace domains, e.g. ["chartnexus.app"]. Empty allows any
# Google account, including personal gmail.com addresses.
CN_GOOGLE_ALLOWED_HOSTED_DOMAINS=[]

# --- broker ----------------------------------------------------------------
# 'mock' serves generated quotes and option chains — no Fyers account needed.
CN_BROKER_PROVIDER=mock
CN_BROKER_FYERS_APP_ID=
CN_BROKER_FYERS_SECRET_ID=
CN_BROKER_FYERS_REDIRECT_URI=http://localhost:5173/settings/broker/callback
CN_BROKER_QUOTA_REQUESTS_PER_SECOND=8

# --- llm / ai console ------------------------------------------------------
# LLM keys are PER-USER. Each user adds their own provider + API key + model at
# Settings -> AI in the app; the key is stored encrypted at rest and the agents
# (Hella, STRYX) read it per request. There is NO shared server key: with no key
# saved, that user's AI Console tab shows an "offline" notice.
#
# Install the model SDK so a saved Anthropic key can be used:  uv sync --extra llm
# (Claude only at launch; OpenAI/OpenRouter are reserved.)
#
# The provider/key/model vars below are LEGACY and no longer serve end users —
# leave them unset. Only the operational knobs are still read from env; all are
# optional and default sensibly:
#   CN_LLM_MAX_OUTPUT_TOKENS=4096
#   CN_LLM_REQUEST_TIMEOUT_SECONDS=30
#   CN_LLM_AGENT_DISCLAIMER=true        # append the educational disclaimer

# --- observability ---------------------------------------------------------
CN_OTEL_SERVICE_NAME=chartnexus
CN_OTEL_LOG_LEVEL=INFO
CN_OTEL_LOG_FORMAT=console          # 'json' in deployed environments
CN_OTEL_TRACES_ENABLED=false
CN_OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# --- market ----------------------------------------------------------------
CN_MARKET_TIMEZONE=Asia/Kolkata
CN_MARKET_SESSION_OPEN=09:15
# 15:40 is the F&O close (from 3 Aug 2026); the cash close stays 15:30.
CN_MARKET_SESSION_CLOSE=15:40
CN_MARKET_SNAPSHOT_INTERVAL_SECONDS=180

# --- option-chain archive (what the Open Interest timeline scrubs over) ------
# Write snapshots even when the chain came from the mock provider. On by default
# in compose.dev.yml; without it a machine with no broker connection never
# accumulates history. Leave false anywhere the data might be believed.
CN_MARKET_INGEST_ALLOW_MOCK=false
CN_MARKET_SNAPSHOT_RETENTION_DAYS=30
# Strikes either side of ATM kept per frame. The widest UI filter is +-20.
CN_MARKET_SNAPSHOT_MAX_SERIES_STRIKES=25
