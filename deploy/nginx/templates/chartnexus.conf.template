# Rendered at container start: the official nginx image runs envsubst over
# /etc/nginx/templates/*.template into /etc/nginx/conf.d/. Only the names in
# NGINX_ENVSUBST_FILTER (see nginx.Dockerfile) are substituted, so nginx's own
# $variables survive untouched.
#
# Every proxy_pass names its host through a `set` variable rather than an
# `upstream` block. That is deliberate and not a style choice: nginx resolves a
# literal hostname in proxy_pass once at startup and caches it forever, so a
# deploy that recreates `api` or `web` would leave this proxy answering 502
# until it was restarted too. A variable sends each lookup through the resolver
# configured in nginx.conf. See the comment there for the rest.

# Port 80: ACME challenges, and a redirect for everything else.
server {
    listen      80;
    listen [::]:80;
    server_name ${CN_DOMAIN};

    # Stays on plain HTTP by necessity — this is what proves the certificate
    # should be issued in the first place. Shared with the certbot container.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen      443 ssl;
    listen [::]:443 ssl;
    http2       on;
    server_name ${CN_DOMAIN};

    ssl_certificate     /etc/nginx/certs/live/${CN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/live/${CN_DOMAIN}/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # Headers for the HTML app. `always` so an error page carries them too. The
    # API locations hide the upstream's duplicates of these five — see
    # snippets/proxy-api.conf.
    add_header Strict-Transport-Security  "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options     "nosniff" always;
    add_header X-Frame-Options            "DENY" always;
    add_header Referrer-Policy            "strict-origin-when-cross-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Permissions-Policy         "geolocation=(), camera=(), microphone=(), payment=()" always;

    limit_conn conn 64;

    # --- API ---------------------------------------------------------------
    # Prefix locations are matched longest-first regardless of the order they
    # appear in, so /api/v1/auth/ below wins over /api/v1/ for a sign-in.
    location /api/v1/ {
        limit_req zone=api burst=60 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Sign-in, registration and refresh, held to a far lower rate. The
    # application already locks an account out after repeated failures; this
    # covers the shape a per-account counter cannot see — one address walking
    # many accounts.
    location /api/v1/auth/ {
        limit_req zone=login burst=10 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # --- websockets --------------------------------------------------------
    # Reserved, not wired. `backend/.../main_realtime.py` is an empty
    # placeholder and nothing in the browser bundle opens a socket yet, so
    # there is no upstream to name here. When that process exists, add it to
    # compose.prod.yml and proxy to it. Until then an explicit 501 beats a
    # connection that hangs until it times out.
    location /ws {
        return 501;
    }

    # --- health ------------------------------------------------------------
    # For an external uptime monitor. Liveness only: /health/ready names the
    # dependencies and how they failed, which is not something to publish. The
    # containers check each other directly on the compose network.
    location = /healthz {
        access_log off;
        set $api_upstream "api:8000";
        proxy_pass http://$api_upstream/health/live;
        proxy_set_header Host $host;
    }

    # --- the application ---------------------------------------------------
    # React Router emits hashed filenames under /assets/, so they can be
    # cached indefinitely. Declaring an add_header here stops the server-level
    # set from being inherited, which is why they are repeated.
    location /assets/ {
        set $web_upstream "web:3000";
        proxy_pass http://$web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host       $host;
        proxy_set_header Connection "";

        add_header Cache-Control              "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security  "max-age=63072000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options     "nosniff" always;
    }

    location / {
        set $web_upstream "web:3000";
        proxy_pass http://$web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID      $request_id;
        # Carries a websocket handshake through if one is ever added here; an
        # ordinary request sets $connection_upgrade empty (see nginx.conf).
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }
}
