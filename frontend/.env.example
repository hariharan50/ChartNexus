# Frontend configuration. Copy to frontend-react/.env and adjust.
#   cp frontend-react/.env.example frontend-react/.env
#
# Only PUBLIC_-prefixed variables reach the browser bundle (see `envPrefix` in
# vite.config.ts). Anything else stays server-side — never put a secret in a
# PUBLIC_ variable.

# --- browser-visible -------------------------------------------------------
# Same-origin paths: the Vite dev server proxies them to the backend, so the
# session cookie works without cross-origin credentials.
PUBLIC_API_BASE_URL=/api/v1
PUBLIC_WS_URL=/ws
PUBLIC_ENVIRONMENT=local

# --- server-side (dev proxy targets) --------------------------------------
API_PROXY_TARGET=http://localhost:8000
WS_PROXY_TARGET=ws://localhost:8001

# Where server-side loaders reach the API. The browser calls the same-origin
# path `/api/v1/...`; a loader has no origin to resolve that against, and must
# not loop back through this Node process. SvelteKit's `handleFetch` hid this —
# see app/lib/shared/api/server-fetch.ts.
API_INTERNAL_URL=http://localhost:8000

# --- e2e -------------------------------------------------------------------
E2E_BASE_URL=http://localhost:4173
