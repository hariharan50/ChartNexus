# Frontend configuration. Copy to frontend/.env and adjust.
#   cp frontend/.env.example frontend/.env
#
# Only PUBLIC_-prefixed variables reach the browser bundle (see
# svelte.config.js). Anything else stays server-side — never put a secret in a
# PUBLIC_ variable.

# --- browser-visible -------------------------------------------------------
# Same-origin paths: the Vite dev server proxies them to the backend, so the
# session cookie works without cross-origin credentials.
PUBLIC_API_BASE_URL=/api/v1
PUBLIC_WS_URL=/ws
PUBLIC_ENVIRONMENT=local

# --- server-side (dev proxy targets) --------------------------------------
API_PROXY_TARGET=http://localhost:8000
WS_PROXY_TARGET=ws://localhost:8001

# --- e2e -------------------------------------------------------------------
E2E_BASE_URL=http://localhost:4173
