# Production environment for the VPS stack.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   # fill in every value marked REQUIRED, then:
#   docker compose --env-file .env.production -f deploy/compose/compose.prod.yml up -d
#
# This is the ONLY file to edit on the server. compose.prod.yml maps these onto
# the ~90 CN_* application settings, so there is no backend/.env in production —
# anything not listed here keeps the default declared in
# backend/src/chartnexus/bootstrap/settings.py.
#
# Never commit the filled-in copy. `.env.*` is git-ignored apart from the
# examples, so `.env.production` stays out on its own.

# ===========================================================================
# REQUIRED — the stack refuses to start without these
# ===========================================================================

# The hostname the app is served on, with no scheme and no trailing slash. Its
# A/AAAA record must already point at this VPS before certificates can be
# issued. Used for the TLS certificate, the cookie domain, the CORS allow-list
# and both OAuth redirect URIs.
CN_DOMAIN=chartnexus.example.com

# --- database --------------------------------------------------------------
# The password is interpolated into a URL, so keep it to URL-safe characters:
# @ : / ? # [ ] and % would all have to be percent-encoded, and a DSN that
# silently parses wrong is a bad afternoon. This generates a safe one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=chartnexus
POSTGRES_PASSWORD=
POSTGRES_DB=chartnexus

# Same constraint — it goes into the Redis DSN.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# --- secrets ---------------------------------------------------------------
# Generate each one separately. Never reuse a value across the three, and never
# reuse a development value: assert_deployment_safe() rejects the shipped
# defaults, but it cannot tell a weak secret from a strong one.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Signs sessions and websocket tickets.
CN_SECURITY_SECRET_KEY=

# AES-256-GCM key material for broker credentials and per-user LLM keys at
# rest. At least 32 bytes.
#
# LOSING THIS MEANS LOSING EVERY STORED CREDENTIAL. Back it up somewhere other
# than this VPS before the first user connects a broker account. To rotate it,
# put the old value in CN_SECURITY_PREVIOUS_ENCRYPTION_KEYS (comma-separated)
# so existing rows still decrypt and are re-encrypted on their next write;
# drop it once nothing decrypts with it any more.
CN_SECURITY_ENCRYPTION_KEY=
CN_SECURITY_PREVIOUS_ENCRYPTION_KEYS=

# Signs access and refresh tokens. Must be set explicitly in a deployed
# environment rather than inherited from CN_SECURITY_SECRET_KEY; HS256 needs at
# least 32 bytes.
CN_AUTH_JWT_SIGNING_KEY=

# ===========================================================================
# OPTIONAL — every one of these has a working default
# ===========================================================================

# --- broker ----------------------------------------------------------------
# Only 'fyers' is valid here: assert_deployment_safe() rejects 'mock' outside
# local development, because a chart drawn from generated numbers looks exactly
# like one drawn from the exchange and only `provenance.source` tells them
# apart. No app credentials go here — each tenant connects their own FYERS
# application in-app under Settings -> Broker, stored encrypted per tenant.
CN_BROKER_PROVIDER=fyers

# --- who can sign up -------------------------------------------------------
# Defaults to closed. Open it, create your accounts, close it again — or leave
# it open if public sign-up is the intent.
CN_AUTH_REGISTRATION_ENABLED=false
CN_AUTH_REQUIRE_EMAIL_VERIFICATION=false

# --- google sign-in --------------------------------------------------------
# Leave blank to disable; everything else still works. Create an OAuth 2.0
# Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and register
# https://<CN_DOMAIN>/auth/google/callback as an authorised redirect URI.
CN_GOOGLE_CLIENT_ID=
CN_GOOGLE_CLIENT_SECRET=

# --- sizing ----------------------------------------------------------------
# Defaults assume roughly 4 GB of RAM. The ten backend containers each hold a
# Python process, so raising API workers is usually not the first thing to do.
#
# A rule of thumb for the API: (2 x cores) + 1, capped by memory.
CN_API_WORKERS=2
CN_API_MEMORY_LIMIT=1g
CN_WEB_MEMORY_LIMIT=512m

# Postgres. shared_buffers at ~25% of the RAM you are willing to give it,
# effective_cache_size at ~50-75% of total system RAM.
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB

# Redis holds market snapshots (all TTL-bearing) and sessions.
REDIS_MEMORY_LIMIT=768m
REDIS_MAXMEMORY=512mb

# --- market data cadence ---------------------------------------------------
# Seconds between option-chain captures. This sets the resolution of every
# Options Lab chart and is the main consumer of the broker's daily quota.
CN_MARKET_SNAPSHOT_INTERVAL_SECONDS=180

# Trading days of archive kept before the nightly prune drops them. Each day
# is roughly 51 strikes x 2 sides x 130 frames per instrument, so raising this
# costs disk in a straight line.
CN_MARKET_SNAPSHOT_RETENTION_DAYS=30

# --- logging ---------------------------------------------------------------
# DEBUG logs every broker request and is far too noisy to leave on. Format is
# forced to json in compose.prod.yml.
CN_OTEL_LOG_LEVEL=INFO

# --- images ----------------------------------------------------------------
# Tag applied to the images this stack builds. Set it to a git SHA in CI so a
# rollback is `CN_IMAGE_TAG=<previous sha> docker compose up -d`.
CN_IMAGE_TAG=latest

# --- certificates ----------------------------------------------------------
# Where Let's Encrypt sends expiry warnings. Read by
# scripts/operations/issue-certificate.sh, not by compose.
CN_ACME_EMAIL=
