# Root .env — read by docker compose only.
#
# Application configuration lives in backend/.env and frontend/.env; this file
# holds just the values compose itself interpolates.
#   cp .env.example .env

# --- container ports (host side) -------------------------------------------
# Defaults avoid 5432/6379 so a locally installed Postgres or Redis keeps working.
POSTGRES_PORT=5433
REDIS_PORT=6381

# --- database bootstrap ----------------------------------------------------
POSTGRES_USER=marketcompass
POSTGRES_PASSWORD=marketcompass
POSTGRES_DB=marketcompass

# --- adapters used by the containerised backend ----------------------------
MC_BROKER_PROVIDER=mock
MC_LLM_PROVIDER=rule_based
MC_LLM_ANTHROPIC_API_KEY=
