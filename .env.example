# Root .env — read by docker compose only.
#
# Application configuration lives in backend/.env and frontend/.env; this file
# holds just the values compose itself interpolates.
#   cp .env.example .env

# --- container ports (host side) -------------------------------------------
# Defaults avoid 5432/6379 so a locally installed Postgres or Redis keeps working.
POSTGRES_PORT=5433
REDIS_PORT=6381

# --- database bootstrap ----------------------------------------------------
POSTGRES_USER=chartnexus
POSTGRES_PASSWORD=chartnexus
POSTGRES_DB=chartnexus

# --- adapters used by the containerised backend ----------------------------
CN_BROKER_PROVIDER=mock

# --- AI Console (LLM) ------------------------------------------------------
# Nothing to set here. LLM keys are PER-USER now: each user adds their own
# provider + API key + model in the app at Settings -> AI (stored encrypted at
# rest), and the agents (Hella, STRYX) read that key per request. There is no
# shared server key — with none saved, that user's AI Console tab is offline.
#
# Install the model SDK once so a saved key can be used (Claude only at launch):
#   cd backend && uv sync --extra llm